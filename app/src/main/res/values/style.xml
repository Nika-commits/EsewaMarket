<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="SizeSelectorButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/light</item>
        <item name="android:textColor">@color/lightGrey</item>
        <item name="innerCornerSize">12dp</item>
        <item name="cornerRadius">12dp</item>
    </style>


    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="fontFamily">@font/source_sans_regular</item>
        <item name="textFillColor">@color/textDark</item>
    </style>


    <style name="App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

        <item name="android:layout_marginVertical">8dp</item>

        <item name="boxStrokeColor">@color/primaryGreen</item>
        <item name="hintTextColor">@color/primaryGreen</item>
        <item name="cursorColor">@color/primaryGreen</item>

        <item name="startIconTint">@color/lightGrey</item>
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
        <item name="errorTextAppearance">@style/App.TextInputError</item>
    </style>

    <style name="App.TextInputError" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/source_sans_regular</item>
    </style>

</resources>


