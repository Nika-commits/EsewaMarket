<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SizeSelectorButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/light</item>
        <item name="android:textColor">@color/lightGrey</item>
        <item name="innerCornerSize">12dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="fontFamily">@font/source_sans_regular</item>
        <item name="android:textColor">@color/textDark</item>
    </style>

    <style name="App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <!-- Corners -->
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>

        <item name="android:layout_marginVertical">8dp</item>

        <item name="boxBackgroundColor">@color/inputBackground</item>

        <!-- Border -->
        <item name="boxStrokeColor">@color/text_input</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>

        <item name="strokeColor">@color/inputBorder</item>

        <!-- Hint -->
        <item name="hintTextColor">@color/textLight</item>
        <item name="android:textColorHint">@color/light</item>

        <!-- Icons -->
        <item name="startIconTint">@color/lightGrey</item>

        <!-- Error -->
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
        <item name="errorTextAppearance">@style/App.TextInputError</item>
    </style>
    >

    <style name="App.TextInputError" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/source_sans_regular</item>

    </style>

    <style name="App.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/primaryGreen</item>

        <item name="android:textColor">@color/surface</item>
        <item name="android:fontFamily">@font/source_sans_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>


    <style name="App.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="backgroundTint">@color/textDark300</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/lightGrey</item>
        <item name="cornerRadius">16dp</item>

        <item name="android:fontFamily">@font/source_sans_semibold</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">16sp</item>

        <item name="iconSize">24dp</item>
        <item name="iconTint">@null</item>
    </style>

    <style name="App.Loader" parent="Widget.Material3.LoadingIndicator">
        <item name="indicatorColor">@color/primaryGreen</item>
        <item name="containerColor">@color/secondaryGreen</item>
    </style>

    <style name="ThemeOverlay.XMLApp.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <item name="colorPrimary">@color/primaryGreen</item>
        <item name="colorSecondary">@color/secondaryGreen</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textDark</item>
        <item name="colorOnSurfaceVariant">@color/lightGrey</item>

        <item name="alertDialogStyle">
            @style/MaterialAlertDialog.XMLApp
        </item>

        <item name="materialAlertDialogTitleTextStyle">
            @style/MaterialAlertDialog.XMLApp.Title
        </item>

        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.XMLApp.DialogButton
        </item>

        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.XMLApp.DialogButton
        </item>
    </style>

    <style name="MaterialAlertDialog.XMLApp" parent="MaterialAlertDialog.Material3">

        <item name="shapeAppearance">
            @style/ShapeAppearance.XMLApp.Dialog
        </item>
    </style>

    <style name="MaterialAlertDialog.XMLApp.Title" parent="MaterialAlertDialog.Material3.Title.Text">

        <item name="android:textColor">@color/primaryGreenDark</item>
    </style>

    <style name="Widget.XMLApp.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">

        <item name="android:textColor">@color/primaryGreenDark</item>
    </style>

    <style name="ShapeAppearance.XMLApp.Dialog" parent="ShapeAppearance.Material3.MediumComponent">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.App.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Snackbar</item>
    </style>

    <style name="Widget.App.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/primaryGreen</item>
    </style>

    <style name="ThemeOverlay.App.Snackbar" parent="">
        <item name="colorPrimaryInverse">@color/surface</item>
        <item name="colorOnSurfaceInverse">@color/surface</item>
    </style>

    <style name="App.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/textLighter</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/lightCharcoal</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>

        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/source_sans_regular</item>

        <item name="chipSpacing">8dp</item>

        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
    </style>
</resources>