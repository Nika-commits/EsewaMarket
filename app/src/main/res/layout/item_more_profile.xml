<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_16"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/profile_picture_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_user_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_default" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/user_details_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/tv_view_profile"
            app:layout_constraintStart_toEndOf="@id/profile_picture_container"
            app:layout_constraintTop_toTopOf="@id/profile_picture_container">

            <TextView
                android:id="@+id/tv_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/source_sans_semibold"
                android:includeFontPadding="true"
                android:text="Pranish Chaulagain"
                android:textColor="@color/textDark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/source_sans_regular"
                android:text="+977-9823467917"
                android:textColor="@color/textDark200"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_view_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/source_sans_semibold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="View Profile"
            android:textColor="@color/primaryGreen"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/textLight300" />

        <TextView
            android:id="@+id/tv_my_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans_semibold"
            android:paddingHorizontal="16dp"
            android:text="My Profile"
            android:textColor="@color/textDark400"
            android:textSize="14sp" />

        <include
            android:id="@+id/my_products"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/shipping_address"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/textLight300" />

        <TextView
            android:id="@+id/tvMyOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/source_sans_semibold"
            android:paddingHorizontal="16dp"
            android:text="My Orders"
            android:textColor="@color/textDark400"
            android:textSize="14sp" />

        <include
            android:id="@+id/myOrder"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/myReturn"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/myCancellation"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/textLight300" />

        <TextView
            android:id="@+id/tvRewardsAndPromotion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/source_sans_semibold"
            android:paddingHorizontal="16dp"
            android:text="Rewards &amp; Promotions"
            android:textColor="@color/textDark400"
            android:textSize="14sp" />

        <include
            android:id="@+id/myRewardsAndPoints"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/myApplyPromocode"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <include
            android:id="@+id/myDailyDayBonus"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/textLight300" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/primaryGreen"
            android:fontFamily="@font/source_sans_semibold"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="LOGOUT"
            android:textColor="@color/surface" />

    </LinearLayout>

</LinearLayout>