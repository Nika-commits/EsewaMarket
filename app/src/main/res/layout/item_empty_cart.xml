<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="344dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:background="@drawable/bg_surface_16"
    android:layout_margin="16dp">

    <ImageView
        android:id="@+id/ivEmptyCart"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvEmptyCart"
        android:src="@drawable/ic_empty_cart" />

    <TextView
        android:id="@+id/tvEmptyCart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Empty Cart"
        android:fontFamily="@font/source_sans_semibold"
        android:textSize="20sp"
        android:letterSpacing="0.02"
        android:textColor="@color/lightGrey"
        app:layout_constraintTop_toBottomOf="@+id/ivEmptyCart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvEmptyCartDescription" />

    <TextView
        android:id="@+id/tvEmptyCartDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No items added to the cart yet"
        android:fontFamily="@font/source_sans_regular"
        android:textColor="@color/textDark200"
        app:layout_constraintTop_toBottomOf="@id/tvEmptyCart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnContinueShopping" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueShopping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTINUE SHOPPING"
        android:textSize="14sp"
        android:fontFamily="@font/source_sans_semibold"
        android:letterSpacing="0.12"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetRight="0dp"
        android:insetLeft="0dp"
        android:background="@drawable/bg_button_primary_8"
        app:layout_constraintTop_toBottomOf="@id/tvEmptyCartDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>